<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Movie Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Roboto', sans-serif;
            color: #333;
        }

        .container {
            margin-top: 80px;
            max-width: 900px;
        }

        .form-card {
            background-color: #fff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
            margin: 20px 0;
            transition: all 0.3s ease-in-out;
        }

        .form-card:hover {
            box-shadow: 0 16px 60px rgba(0, 0, 0, 0.2);
            transform: translateY(-4px);
        }

        h2 {
            font-size: 2.5rem;
            font-weight: 600;
            color: #2c3e50;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group label {
            font-size: 1.1rem;
            font-weight: 500;
            color: #333;
            margin-bottom: 10px;
        }

        .form-control {
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            color: #555;
            border-radius: 10px;
            padding: 14px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 10px rgba(52, 152, 219, 0.3);
        }

        .btn-update {
            background-color: #3498db;
            border: none;
            padding: 14px;
            font-weight: 600;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-update:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
        }

        .btn-update:active {
            transform: translateY(0);
        }

        .form-group img {
            max-width: 180px;
            border-radius: 8px;
            margin-top: 15px;
            display: block;
            margin-bottom: 15px;
        }

        .form-group input[type="file"] {
            padding: 10px;
            font-size: 1rem;
        }

        .form-group .text-muted {
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .alert {
            font-size: 0.9rem;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 8px;
            color: #fff;
        }

        .alert-danger {
            background-color: #e74c3c;
        }

        .alert-success {
            background-color: #2ecc71;
        }

        .custom-placeholder {
            color: #7f8c8d;
        }

        .form-control::placeholder {
            color: #aaa;
        }

        .form-card h2 {
            color: #2c3e50;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="form-card">
            <h2>🎬 Edit Movie</h2>

            <!-- Alert for form messages (success or error) -->
            <div id="alert-message" class="alert alert-success" role="alert" style="display: none;">
                Movie details updated successfully!
            </div>

            <form method="post" action="/editMovie/<%= record.id %>" enctype="multipart/form-data">
                <!-- Movie Name -->
                <div class="form-group">
                    <label for="movieName">Movie Title</label>
                    <input type="text" class="form-control" name="movieName" value="<%= record.movieName %>" placeholder="Enter Movie Title" required>
                </div>

                <!-- Genre -->
                <div class="form-group">
                    <label for="genre">Genre</label>
                    <input type="text" class="form-control" name="genre" value="<%= record.genre %>" placeholder="Enter Genre" required>
                </div>

                <!-- Ticket Price -->
                <div class="form-group">
                    <label for="ticketPrice">Ticket Price (₹)</label>
                    <input type="number" class="form-control" name="ticketPrice" value="<%= record.ticketPrice %>" placeholder="Enter Ticket Price" required>
                </div>

                <!-- Rating -->
                <div class="form-group">
                    <label for="rating">Rating</label>
                    <input type="text" class="form-control" name="rating" value="<%= record.rating %>" placeholder="Enter Rating" required>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea class="form-control" name="description" rows="4" placeholder="Enter Movie Description" required><%= record.description %></textarea>
                </div>

                <!-- Movie Image -->
                <div class="form-group">
                    <label for="movieImage">Movie Image</label>
                    <input type="file" class="form-control" name="movieImage">
                    <img src="../<%= record.movieImage %>" class="img-thumbnail mt-2" alt="Current Movie Image">
                    <small class="text-muted">Upload a new image if required. Leave empty to keep the existing image.</small>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-update">Update Movie</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
