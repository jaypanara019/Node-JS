<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= movie.movieName %> - Details
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        /* Global Styles */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
            background-color: #121212;
        }

        /* Hero Image Styles */
        .hero-image {
            width: 100%;
            height: 75vh;
            background: url('<%= movie.movieImage %>') center/cover no-repeat;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease-in-out;
        }

        .hero-image:hover {
            transform: scale(1.05);
        }

        .movie-details-container {
            padding: 40px 20px;
            background-color: #181818;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            max-width: 1200px;
            margin: -30px auto 0;
            z-index: 1;
            margin-top: -60px;
        }

        .movie-info {
            padding: 30px;
            background-color: rgba(0, 0, 0, 0.75);
            border-radius: 10px;
            margin-top: -40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
        }

        .movie-title {
            font-size: 3.2rem;
            font-weight: bold;
            color: #e50914;
            margin-bottom: 20px;
            text-transform: capitalize;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
        }

        .movie-description {
            font-size: 1.2rem;
            color: #ddd;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .movie-info i {
            margin-right: 10px;
        }

        .movie-info span {
            font-size: 1.1rem;
            color: #bbb;
            margin-bottom: 15px;
            display: inline-block;
        }

        .rating {
            font-size: 1.5rem;
            color: #ffca28;
            margin-bottom: 25px;
        }

        /* Action Buttons */
        .action-buttons {
            margin-top: 20px;
            display: flex;
            gap: 15px;
        }

        .btn-action {
            padding: 10px 20px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-edit {
            background-color: #43a047;
            border: 2px solid #43a047;
            color: white;
        }

        .btn-edit:hover {
            background-color: #388e3c;
            border-color: #388e3c;
            transform: translateY(-3px);
        }

        .btn-delete {
            background-color: #d32f2f;
            border: 2px solid #d32f2f;
            color: white;
        }

        .btn-delete:hover {
            background-color: #b71c1c;
            border-color: #b71c1c;
            transform: translateY(-3px);
        }

        .btn-back {
            background-color: #0ae4f4;
            border: 2px solid #0ae4f4;
            color: white;
        }

        .btn-back:hover {
            background-color: #0a79f4;
            border-color: #0a79f4;
            color: black;
            transform: translateY(-3px);
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .movie-title {
                font-size: 2.5rem;
            }

            .movie-description,
            .movie-info span,
            .rating {
                font-size: 1rem;
            }

            .action-buttons {
                flex-direction: column;
                align-items: center;
            }

            .hero-image {
                height: 60vh;
            }
        }

        /* Back to Home Button */
        .btn-back {
            width: 100%;
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- Hero Image Section (Image Only) -->
    <div class="hero-image">
        <img src="../<%= movie.movieImage %>" alt="<%= movie.movieName %>" width="300px">
    </div>

    <!-- Movie Details Section -->
    <div class="container movie-details-container">
        <div class="movie-info">
            <h2 class="movie-title"><%= movie.movieName %></h2>
            <span><i class="bi bi-cash-coin"></i> ₹<%= movie.ticketPrice %></span>
            <span><i class="bi bi-film"></i> <%= movie.genre %></span>

            <p class="movie-description">
                <strong>Description:</strong> <%= movie.description %>
            </p>

            <div class="rating">
                <strong>Rating:</strong> <%= movie.rating %> <i class="bi bi-star-fill"></i>
            </div>

            <div class="action-buttons mb-3">
                <a href="/updateMovie/<%= movie.id %>" class="btn btn-edit btn-action">Edit</a>
                <a href="/delete/delMovie?id=<%= movie.id %>" class="btn btn-delete btn-action">Delete</a>
            </div>

            <a href="/" class="btn btn-back btn-action">Back To Home Page <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
